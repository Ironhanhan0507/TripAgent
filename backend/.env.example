# ===== 数据库 =====
DATABASE_URL=postgresql://tripagent:tripagent_dev@127.0.0.1:5432/tripagent?schema=public

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# ===== 服务 =====
PORT=3000
NODE_ENV=development

# ===== JWT（生产环境务必替换为强随机值） =====
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=30d

# ===== LLM（OpenAI 兼容接口，如 硅基流动 / DeepSeek / 智谱） =====
# LLM_PROVIDER: mock=离线规则解析；其他任意值走 OpenAI 兼容接口
LLM_PROVIDER=siliconflow
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# ===== 景点数据 Provider（P5 可切换） =====
# mock=内置离线确定性目录（多城市，可离线跑通全流程）；接入真实服务后切换实现
PLACES_PROVIDER=mock
