// Prisma schema —— TripAgent 数据模型
// P0：User + RefreshToken（认证）；P1：Conversation + Message（对话）

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  conversations Conversation[]
  itineraries   Itinerary[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
  itineraries Itinerary[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  kind           String @default("text") // text | requirement | plan | ...
  content        String
  payload        Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

// P4：已保存的行程。主数据冗余在 itineraryData（JSONB），便于快速渲染与版本管理。
model Itinerary {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  title          String
  destination    String
  startDate      String
  endDate        String
  totalBudget    Float?
  currency       String       @default("CNY")
  status         String       @default("saved") // saved | draft
  version        Int          @default(1)
  itineraryData  Json
  requirement    Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@map("itineraries")
}
